#!/bin/sh
# Bloqueia arquivos sensíveis em A (added), M (modified), R (renamed), C (copied).
# Permite D (deleted) — remover do tracking é seguro.
PATTERNS='(^|/)(\.env$|\.env\.[^e].*$|.*\.log$|.*\.save$|.*\.bak$|.*\.pem$|.*\.key$|venv/|__pycache__/)'

BAD=$(git diff --cached --name-status \
  | grep -E '^[AMRC]' \
  | grep -E "$PATTERNS" \
  | awk '{print $2}')

if [ -n "$BAD" ]; then
  echo "❌ Commit bloqueado. Arquivos sensíveis:"
  echo "$BAD"
  echo "Use 'git commit --no-verify' para forçar."
  exit 1
fi
exit 0
